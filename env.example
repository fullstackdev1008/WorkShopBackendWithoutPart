# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL Database
DATABASE_URL=postgresql://username:password@localhost:5432/security_gate_db

# Frontend URL (for approval links)
FRONTEND_URL=http://localhost:5173

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Email (SMTP) — for sending estimate emails to customers
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=TrueGear Workshop <your-email@gmail.com>

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
