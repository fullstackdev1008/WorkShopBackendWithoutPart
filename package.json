{
  "name": "workshop-backend-without-part",
  "version": "1.0.0",
  "description": "Security Gate Vehicle Entry System API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon ./src/server.ts",
    "build": "tsc && node scripts/copy-drizzle.mjs",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:deploy": "drizzle-kit migrate --config=drizzle.config.ts",
    "migrate": "node dist/scripts/migrate.js",
    "db:seed": "ts-node-dev --transpile-only src/scripts/seed.ts",
    "db:seed:bays": "ts-node-dev --transpile-only src/scripts/seedWorkshopBays.ts",
    "db:seed:jh6-amc": "ts-node-dev --transpile-only src/scripts/seedJH6AmcAssignments.ts",
    "sync:lookups": "node dist/scripts/syncLookupTables.js",
    "sync:franchises": "node dist/scripts/syncFranchisesPerCompany.js",
    "db:truncate": "ts-node-dev --transpile-only src/scripts/truncate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.77.0",
    "@aws-sdk/client-s3": "^3.999.0",
    "@aws-sdk/s3-request-presigner": "^3.999.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "fast-xml-parser": "^5.5.4",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.2",
    "pg": "^8.12.0",
    "sharp": "^0.34.5",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.19.17",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.24.2",
    "mime-types": "^3.0.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
