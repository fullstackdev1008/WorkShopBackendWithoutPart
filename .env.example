# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL Database
DATABASE_URL=postgresql://username:password@localhost:5432/security_gate_db

# Frontend URL (for approval links)
FRONTEND_URL=http://localhost:5173

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Email (SMTP) — for sending estimate emails to customers
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=TrueGear Workshop <your-email@gmail.com>

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Evolve — FULL job-card sync freeze (entire lifecycle).
# false (default) = current behaviour: job cards CREATE in Evolve and every
#                   later change (technician, foreman, RO status, labour lines,
#                   SA edits, reconcile cron) is pushed as an UPDATE.
# true            = Evolve receives NOTHING for a job card, ever. No CREATE, so
#                   a newly created job card never appears in Evolve at all; no
#                   UPDATE, no RO status progression, no labour lines, no
#                   duplicate-recovery lookup, no reconcile traffic, no retries.
#                   The local job-card workflow is completely unaffected.
EVOLVE_SYNC_FREEZE=false

# Gate Entry vision scans (plate / licence / odometer). Server-side only.
OPENAI_API_KEY=
